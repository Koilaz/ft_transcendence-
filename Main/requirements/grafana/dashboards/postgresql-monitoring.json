    {
      "id": 5,
      "title": "PostgreSQL Cache Hit Ratio",
      "description": "",
      "type": "stat",
      "pluginVersion": "13.3.0",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "100 *\nsum(rate(pg_stat_database_blks_hit{datname=\"transcendencebdd\"}[5m]))\n/\n(\n  sum(rate(pg_stat_database_blks_hit{datname=\"transcendencebdd\"}[5m]))\n  +\n  sum(rate(pg_stat_database_blks_read{datname=\"transcendencebdd\"}[5m]))\n)",
          "legendFormat": "__auto",
          "range": true,
          "refId": "A",
          "hide": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": 0,
                "color": "green"
              },
              {
                "value": 80,
                "color": "red"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 8,
        "h": 8
      }
    }
