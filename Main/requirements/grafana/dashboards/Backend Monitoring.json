    {
      "id": 1,
      "title": "Browser HTTP responses (nginx)",
      "description": "Real responses for page loads, assets and API requests at nginx. Tool dashboards and metrics scrapes are excluded.",
      "type": "bargauge",
      "pluginVersion": "13.3.0",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (status) (nginx_http_response_count_total)",
          "legendFormat": "__auto",
          "range": true,
          "refId": "A",
          "hide": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "displayMode": "lcd",
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "maxVizHeight": 300,
        "minVizHeight": 16,
        "minVizWidth": 8,
        "namePlacement": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "sizing": "auto",
        "textMode": "auto",
        "valueMode": "color"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": 0,
