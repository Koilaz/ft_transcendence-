
# nom du projet docker compose. A ne pas changer : par defaut compose prend le
# nom du dossier courant, donc deux clones dans des dossiers differents
# deviennent deux projets separes, avec chacun leurs volumes et leurs
# containers. Le fixer ici garantit qu'on parle toujours du meme projet, quel
# que soit le dossier ou la machine.
COMPOSE_PROJECT_NAME=ft_transcendence

# le nom de domaine que Nginx utilisera.
# Il doit :
# correspondre au certificat SSL
# être dans /etc/hosts
# être utilisé dans la config nginx
# Ce sera l’URL du site.

DOMAIN_NAME=localhost
NGINX_PORT=8443

# le nom de la base de données que Postgres va créer.
POSTGRES_DB=transcendencebdd

# l’utilisateur postgres a créer.
# C’est un utilisateur SQL.
POSTGRES_USER=userbdd

# répertoire persistant pour les modèles Ollama (/root/.ollama dans le container).
# sur sgoinfre pour survivre au nettoyage de $HOME. remplace <login> par ton login 42.
OLLAMA_DATA_DIR=/sgoinfre/goinfre/Perso/<login>/ollama
# le modele doit etre pull dans le container : docker exec ollama ollama pull <modele>
OLLAMA_MODEL=llama3.2:3b

# compte admin de Grafana (https://<DOMAIN_NAME>:<NGINX_PORT>/grafana/).
GRAFANA_ADMIN_USER=admin
# à générer : openssl rand -hex 24
GRAFANA_ADMIN_PASSWORD=
# webhook Discord où partent les alertes Grafana
# (salon > Modifier > Intégrations > Webhooks). Obligatoire : vide, Grafana
# refuse de démarrer (contact-points.yml invalide). Pour tester sans Discord,
# n'importe quelle URL convient, ex. http://localhost/webhook-discord-a-remplacer
GRAFANA_DISCORD_WEBHOOK=

# mot de passe du super-utilisateur elastic, aussi le compte de connexion à
# Kibana (https://<DOMAIN_NAME>:<NGINX_PORT>/kibana/).
# les mots de passe ELK sont injectés tels quels dans du JSON par les scripts
# d'init : les générer en hex (openssl rand -hex 24), sans guillemet ni \.
ELASTIC_PASSWORD=
# compte logstash_internal, créé par elasticsearch-init.
LOGSTASH_PASSWORD=
# compte kibana_system, avec lequel Kibana se connecte à Elasticsearch.
KIBANA_PASSWORD=
# clés de chiffrement de Kibana, 32 caractères minimum : openssl rand -hex 32
KIBANA_SECURITY_ENCRYPTION_KEY=
KIBANA_SAVED_OBJECTS_ENCRYPTION_KEY=
KIBANA_REPORTING_ENCRYPTION_KEY=

